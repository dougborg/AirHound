{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dougborg/AirHound/main/schemas/desktop-ble.v1.schema.json",
  "title": "AirHound desktop BLE observation v1",
  "description": "Desktop observation with backend-scoped identity, optional observed address, and optional bounded OS advertisement snapshot. Normalized snapshots may contain cached fields; they are not raw packets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "peripheral_id",
    "identity_scope",
    "address_type",
    "name",
    "rssi",
    "service_uuids",
    "manufacturer_id",
    "match",
    "ts"
  ],
  "dependentRequired": {
    "address": [
      "address_source"
    ],
    "address_source": [
      "address"
    ]
  },
  "properties": {
    "type": {
      "const": "ble_observation"
    },
    "peripheral_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "identity_scope": {
      "enum": [
        "corebluetooth",
        "btleplug"
      ]
    },
    "address": {
      "type": "string",
      "pattern": "^[0-9A-F]{2}(:[0-9A-F]{2}){5}$",
      "not": {
        "enum": [
          "00:00:00:00:00:00",
          "FF:FF:FF:FF:FF:FF"
        ]
      }
    },
    "address_source": {
      "enum": [
        "corebluetooth_private",
        "btleplug"
      ]
    },
    "address_type": {
      "enum": [
        "public",
        "random",
        "unknown"
      ]
    },
    "name": {
      "type": "string",
      "maxLength": 33
    },
    "rssi": {
      "type": "integer",
      "minimum": -128,
      "maximum": 127
    },
    "service_uuids": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65535
      }
    },
    "manufacturer_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "match": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "detail"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "detail": {
            "type": "string",
            "maxLength": 32
          }
        }
      }
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "advertisement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance",
        "freshness",
        "completeness",
        "address_type",
        "rssi_available",
        "advertised_services",
        "manufacturer_data",
        "service_data",
        "capacity"
      ],
      "properties": {
        "provenance": {
          "const": "os_property_snapshot"
        },
        "freshness": {
          "const": "possibly_cached"
        },
        "completeness": {
          "const": "unknown"
        },
        "address_type": {
          "enum": [
            "public",
            "random",
            "unknown"
          ]
        },
        "rssi_available": {
          "type": "boolean",
          "description": "When false the legacy outer rssi=0 is an unavailable-value placeholder, never a measured signal."
        },
        "receiver_id": {
          "type": "string"
        },
        "advertised_services": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "manufacturer_data": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "company_id",
              "payload",
              "original_len",
              "truncated"
            ],
            "properties": {
              "company_id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "payload": {
                "type": "array",
                "maxItems": 1024,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              },
              "original_len": {
                "type": "integer",
                "minimum": 0
              },
              "truncated": {
                "type": "boolean"
              }
            }
          }
        },
        "service_data": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "uuid",
              "payload",
              "original_len",
              "truncated"
            ],
            "properties": {
              "uuid": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "payload": {
                "type": "array",
                "maxItems": 1024,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              },
              "original_len": {
                "type": "integer",
                "minimum": 0
              },
              "truncated": {
                "type": "boolean"
              }
            }
          }
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "omitted_uuids",
            "omitted_manufacturer_records",
            "omitted_service_records",
            "truncated_payloads"
          ],
          "properties": {
            "omitted_uuids": {
              "type": "integer",
              "minimum": 0
            },
            "omitted_manufacturer_records": {
              "type": "integer",
              "minimum": 0
            },
            "omitted_service_records": {
              "type": "integer",
              "minimum": 0
            },
            "truncated_payloads": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "policy",
        "pack",
        "ruleset",
        "sig",
        "rules",
        "more",
        "basis",
        "alert"
      ],
      "properties": {
        "engine": {
          "const": "evidence-1"
        },
        "policy": {
          "enum": [
            "rules_and_watchlist",
            "watchlist_only",
            "all_matches",
            "silent"
          ]
        },
        "pack": {
          "type": "string"
        },
        "ruleset": {
          "type": "string"
        },
        "sig": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "rules": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "sig",
              "more"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "sig": {
                "type": "array",
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              },
              "more": {
                "type": "boolean"
              }
            }
          }
        },
        "more": {
          "type": "boolean"
        },
        "basis": {
          "enum": [
            "observed_fields",
            "possibly_cached"
          ]
        },
        "alert": {
          "enum": [
            "none",
            "suppressed",
            "watchlist",
            "rule",
            "match"
          ]
        }
      }
    }
  }
}
