{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dougborg/AirHound/main/schemas/host-command.v1.schema.json",
  "title": "AirHound Host Command Protocol v1",
  "description": "Validates a single Host→Device NDJSON line. Each line is a JSON object discriminated by the 'cmd' field. Sent over BLE GATT write characteristic or serial UART. Parsed via serde_json_core with a flat RawCommand struct (no internally tagged enum support).",
  "discriminator": {
    "propertyName": "cmd"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/start_cmd"
    },
    {
      "$ref": "#/$defs/stop_cmd"
    },
    {
      "$ref": "#/$defs/status_cmd"
    },
    {
      "$ref": "#/$defs/set_rssi_cmd"
    },
    {
      "$ref": "#/$defs/set_buzzer_cmd"
    },
    {
      "$ref": "#/$defs/set_mode_cmd"
    },
    {
      "$ref": "#/$defs/add_proximity_cmd"
    },
    {
      "$ref": "#/$defs/remove_proximity_cmd"
    },
    {
      "$ref": "#/$defs/clear_proximity_cmd"
    },
    {
      "$ref": "#/$defs/add_watchlist_cmd"
    },
    {
      "$ref": "#/$defs/remove_watchlist_cmd"
    },
    {
      "$ref": "#/$defs/enable_category_cmd"
    },
    {
      "$ref": "#/$defs/export_wigle_cmd"
    }
  ],
  "$defs": {
    "start_cmd": {
      "type": "object",
      "description": "Start WiFi and BLE scanning.",
      "required": [
        "cmd"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "start"
        }
      }
    },
    "stop_cmd": {
      "type": "object",
      "description": "Stop all scanning.",
      "required": [
        "cmd"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "stop"
        }
      }
    },
    "status_cmd": {
      "type": "object",
      "description": "Request a status report. Device responds with a {\"type\":\"status\",...} message.",
      "required": [
        "cmd"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "status"
        }
      }
    },
    "set_rssi_cmd": {
      "type": "object",
      "description": "Update the minimum RSSI threshold. Scan results weaker than this value are discarded before filtering.",
      "required": [
        "cmd",
        "min_rssi"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "set_rssi"
        },
        "min_rssi": {
          "type": "integer",
          "minimum": -128,
          "maximum": 0,
          "description": "Minimum RSSI in dBm (i8). Default: -90. More negative = more permissive."
        }
      }
    },
    "set_buzzer_cmd": {
      "type": "object",
      "description": "Enable or disable the buzzer on M5StickC Plus2. No-op on boards without a buzzer.",
      "required": [
        "cmd",
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "set_buzzer"
        },
        "enabled": {
          "type": "boolean",
          "description": "true to enable, false to disable."
        }
      }
    },
    "set_mode_cmd": {
      "type": "object",
      "description": "Set the operating mode. Controls which rules and features are active.",
      "required": [
        "cmd",
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "set_mode"
        },
        "mode": {
          "type": "string",
          "enum": [
            "ap",
            "client",
            "dongle",
            "standalone"
          ],
          "description": "Operating mode identifier."
        }
      }
    },
    "add_proximity_cmd": {
      "type": "object",
      "description": "Add a MAC address to the proximity tracking list. The device will emit proximity updates when this target is seen.",
      "required": [
        "cmd",
        "mac"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "add_proximity"
        },
        "mac": {
          "$ref": "#/$defs/mac_address",
          "description": "MAC address of the target to track."
        },
        "label": {
          "type": "string",
          "maxLength": 32,
          "description": "Optional user-assigned label for this target."
        }
      }
    },
    "remove_proximity_cmd": {
      "type": "object",
      "description": "Remove a MAC address from the proximity tracking list.",
      "required": [
        "cmd",
        "mac"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "remove_proximity"
        },
        "mac": {
          "$ref": "#/$defs/mac_address",
          "description": "MAC address to stop tracking."
        }
      }
    },
    "clear_proximity_cmd": {
      "type": "object",
      "description": "Clear all proximity tracking targets.",
      "required": [
        "cmd"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "clear_proximity"
        }
      }
    },
    "add_watchlist_cmd": {
      "type": "object",
      "description": "Add a watchlist entry. Watchlist entries match by OUI prefix (3 bytes) or full MAC (6 bytes) and produce 'watchlist' match reasons.",
      "required": [
        "cmd",
        "id",
        "mac"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "add_watchlist"
        },
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Unique identifier for this watchlist entry (u16)."
        },
        "mac": {
          "$ref": "#/$defs/mac_address",
          "description": "MAC address (full 6 bytes). When full_mac is false, only the first 3 bytes (OUI) are used for matching."
        },
        "full_mac": {
          "type": "boolean",
          "default": false,
          "description": "If true, match all 6 bytes exactly. If false (default), match only the 3-byte OUI prefix."
        },
        "label": {
          "type": "string",
          "maxLength": 32,
          "description": "Optional user-assigned label (e.g. 'My AirTag', 'Neighbor Camera')."
        }
      }
    },
    "remove_watchlist_cmd": {
      "type": "object",
      "description": "Remove a watchlist entry by its ID.",
      "required": [
        "cmd",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "remove_watchlist"
        },
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "ID of the watchlist entry to remove."
        }
      }
    },
    "enable_category_cmd": {
      "type": "object",
      "description": "Enable or disable a match category. When disabled, rules in that category are skipped during filtering.",
      "required": [
        "cmd",
        "category",
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "enable_category"
        },
        "category": {
          "type": "string",
          "maxLength": 16,
          "description": "Category name (e.g. 'Surveillance', 'Network', 'Drone')."
        },
        "enabled": {
          "type": "boolean",
          "description": "true to enable, false to disable."
        }
      }
    },
    "export_wigle_cmd": {
      "type": "object",
      "description": "Request WiGLE CSV data export. Device will output stored sighting data in WiGLE format.",
      "required": [
        "cmd"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "const": "export_wigle"
        }
      }
    },
    "mac_address": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$",
      "maxLength": 18,
      "description": "MAC address in colon-separated hex (e.g. \"B4:1E:52:AB:CD:EF\"). Both uppercase and lowercase are accepted."
    }
  }
}
