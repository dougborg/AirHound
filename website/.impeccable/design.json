      "kind": "custom",
      "refersTo": "text-link",
      "description": "Ordinary reference link, with underline and focus feedback.",
      "html": "<a class=\"ds-link\" href=\"#reference\">Desktop guide</a>",
      "css": ".ds-link {font-family: var(--body, \"Manrope Variable\", sans-serif); color:var(--accent, #1552ce); text-underline-offset:.22em; text-decoration:underline; text-decoration-thickness:1px; } .ds-link:hover { color:var(--accent-hover, #103da0); text-decoration-thickness:2px; } .ds-link:focus-visible { outline: 3px solid var(--accent, #1552ce); outline-offset: 4px; } @media(prefers-reduced-motion:no-preference) { .ds-link { transition:color .15s, background-color .15s; } }"
    },
    {
      "name": "Main navigation",
      "kind": "nav",
      "description": "Wrapping custom-page navigation with a current-page state.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Reference\"><a href=\"#hardware\" aria-current=\"page\">Hardware</a><a href=\"#downloads\">Downloads</a></nav>",
      "css": ".ds-nav { display:flex; flex-wrap:wrap; gap:22px; } .ds-nav a {font-family: var(--body, \"Manrope Variable\", sans-serif); color:var(--ink, #182e49); font-size:.82rem; font-weight:700; text-decoration:none; padding-block:12px; } .ds-nav a:hover, .ds-nav a[aria-current=\"page\"] { color:var(--accent, #1552ce); text-decoration:underline; } .ds-nav a[aria-current=\"page\"] { text-decoration-thickness:2px; } .ds-nav a:focus-visible { outline: 3px solid var(--accent, #1552ce); outline-offset: 4px; }"
    },
    {
      "name": "Filter field",
      "kind": "input",
      "refersTo": "filter-field",
      "description": "Visible label and compact field for catalog filtering.",
      "html": "<label class=\"ds-field\">Search signatures<input type=\"search\" placeholder=\"Search signatures\"></label>",
      "css": ".ds-field {font-family: var(--body, \"Manrope Variable\", sans-serif); display:grid; gap:8px; font-size:.85rem; font-weight:700; } .ds-field input { font:inherit; font-weight:400; padding:11px 13px; background:var(--paper, #f2f5f7); color:var(--ink, #182e49); border:1px solid #758ba6; border-radius:2px; min-width:210px; max-width:100%; caret-color:var(--accent, #1552ce); } .ds-field input:focus-visible { outline: 3px solid var(--accent, #1552ce); outline-offset: 4px; }"
    },
