---
import Site from "../layouts/Site.astro";
import pack from "../../../signatures/builtin.v2.json";
const sources = pack.sources as Record<
  string,
  { url: string; revision: string; reuse: string; verification: string }
>;
---

<Site
  title="Signature evidence"
  description="Inspect AirHound compiled-in signature rules, provenance, review status and matching limitations."
>
  <header class="page-header wrap">
    <h1>Inspect the evidence.</h1>
    <p class="lead">
      Every rule has a scope. A useful signature tells you what matched, where
      the claim came from and what remains uncertain.
    </p>
  </header>
  <div class="wrap content">
    <div class="editorial">
      <div class="body-copy">
        <p>
          The catalog below is generated directly from{" "}
          <a href="https://github.com/dougborg/AirHound/blob/main/signatures/builtin.v2.json">
            the canonical compiled-in data
          </a>
          . Labels preserve legacy behavior; they are not independently
          validated product identifications.
        </p>
        <p>
          Broad names, manufacturer identifiers and services can match unrelated
          devices. Address rotation also means an address count is not a count
          of physical devices.
        </p>
      </div>
      <div class="notice">
        <strong>Compiled-in rules, not downloadable runtime packs.</strong>
        Runtime loading remains{" "}
        <a href="https://github.com/dougborg/AirHound/issues/14">future work</a>
        . Disabled research candidates are separate from this catalog.{" "}
        <a href="/reference/docs/signature-research/">
          Read research and admission criteria.
        </a>
      </div>
    </div>
    <h2>Built-in rule catalog</h2>
    <p class="small">
      Ruleset {pack.ruleset_id} · Profile {pack.profile}. Counts describe rules,
      not reliably identifiable products. This is development data; use tagged
      source for a specific release.
    </p>
    <div class="filters" data-signature-ui hidden>
      <label>
        Search label or rule ID
        <input
          id="signature-search"
          type="search"
          placeholder="For example: Apple or oui"
        />
      </label>
      <label>
        Match field
        <select id="signature-kind">
          <option value="all">All fields</option>
          {[...new Set(pack.signatures.map((s) => s.match.kind))].map(
            (kind) => (
              <option value={kind}>{kind.replaceAll("_", " ")}</option>
            ),
          )}
        </select>
      </label>
      <p id="signature-count" role="status"></p>
    </div>
    <p id="signature-empty" class="empty" hidden>
      No rules match these filters. Clear the search or choose all fields.
    </p>
    {pack.signatures.map((rule) => (
      <article
        class="signature"
        id={rule.id}
        data-signature
        data-search={`${rule.label} ${rule.id}`.toLowerCase()}
        data-kind={rule.match.kind}
      >
        <div>
          <h3>{rule.label}</h3>
          <span class="tag experimental">
            {rule.review.status.replaceAll("_", " ")}
          </span>
          <code class="rule-id">{rule.id}</code>
        </div>
        <div>
          <p>
            <strong>{rule.match.kind.replaceAll("_", " ")}</strong> ·{" "}
            {rule.enabled ? "Enabled in builtins" : "Disabled"}
          </p>
          <p>{rule.review.limitations}</p>
          <details>
            <summary>Matching fields and provenance</summary>
            <pre>{JSON.stringify(rule.match,null,2)}</pre>
            {rule.review.sources.map((id) => (
              <div class="sources">
                <a href={sources[id].url}>{id}</a> ·{" "}
                {sources[id].verification.replaceAll("_", " ")}
                <p>{sources[id].reuse}</p>
              </div>
            ))}
          </details>
        </div>
      </article>
    ))}
    <h2>Improve a rule with a reproducible case.</h2>
    <p>
      Provide labeled device/model/state evidence, ordinary-device negatives,
      source attribution and reuse terms. Keep identifying captures private.{" "}
      <a href="/reference/docs/signature-packs/">
        Follow the authoring contract
      </a>{" "}
      and <a href="/reference/docs/detection-evidence/">evidence policy</a>.
    </p>
  </div>
</Site>
<script>
  const input = document.querySelector<HTMLInputElement>("#signature-search");
  const kind = document.querySelector<HTMLSelectElement>("#signature-kind");
  const rows = [...document.querySelectorAll<HTMLElement>("[data-signature]")];
  document.querySelector("[data-signature-ui]")?.removeAttribute("hidden");
  function filter() {
    const q = input?.value.toLowerCase().trim() ?? "";
    let count = 0;
    for (const row of rows) {
      row.hidden = !(
        row.dataset.search?.includes(q) &&
        (kind?.value === "all" || row.dataset.kind === kind?.value)
      );
      if (!row.hidden) count++;
    }
    const status = document.querySelector("#signature-count");
    if (status) status.textContent = `${count} rules shown`;
    const empty = document.querySelector<HTMLElement>("#signature-empty");
    if (empty) empty.hidden = count > 0;
  }
  input?.addEventListener("input", filter);
  kind?.addEventListener("change", filter);
  filter();
</script>
